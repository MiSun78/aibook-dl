---
import Base from './Base.astro';
import { UNITS, CHAPTERS } from '../data/lessons';

interface Props { n?: number; slug?: string; ids: string[]; }
const { n, slug, ids } = Astro.props;
const idx = UNITS.findIndex((u) => (slug ? u.slug === slug : u.n === n));
const unit = UNITS[idx];
const chapter = CHAPTERS.find((c) => c.code === unit.chapter)!;
const prev = UNITS[idx - 1];
const next = UNITS[idx + 1];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${unit.code} ${unit.title}`} current={unit.slug}>
  <header class="lesson-head">
    <p class="lh-meta">Ⅱ-{chapter.code} {chapter.title}</p>
    <h1><span class="lh-code">{unit.code}</span> {unit.title}</h1>
    <p class="lh-pages">교과서 {unit.pages}</p>
    <div class="lh-grid">
      <div>
        <h2 class="lh-sub">학습 목표</h2>
        <ul>{unit.goals.map((g) => <li>{g}</li>)}</ul>
        <p class="lh-std">성취기준 [{unit.standard}]</p>
      </div>
      <nav aria-label="이 단원의 차례">
        <h2 class="lh-sub">이 단원의 차례</h2>
        <ol class="toc">
          {unit.sections.map((s, i) => (
            <li>
              <a href={`#${ids[i]}`}>
                {s.kind && <span class="toc-kind">{s.kind}</span>}{s.title}
              </a>
              <span class="toc-p">{s.pages}</span>
            </li>
          ))}
          <li><a href="#wrap">정리하기</a><span class="toc-p" /></li>
        </ol>
      </nav>
    </div>
  </header>

  <article class="prose">
    <slot />
  </article>

  <nav class="pager" aria-label="단원 이동">
    {prev ? <a href={`${base}/lessons/${prev.slug}/`}>이전: {prev.code} {prev.title}</a> : <span />}
    {next ? <a href={`${base}/lessons/${next.slug}/`}>다음: {next.code} {next.title}</a> : <span />}
  </nav>
</Base>

<style>
  .lesson-head { max-width: var(--wide); }
  .lh-meta { color: var(--muted); font-weight: 650; margin-bottom: 0.3rem; }
  .lh-code { color: var(--muted); font-weight: 800; }
  .lh-pages { font-size: 1.05rem; font-weight: 650; color: var(--ink-2); margin: 0.4rem 0 1.4rem; }
  .lh-grid {
    display: grid; grid-template-columns: 1fr 1.15fr; gap: 1.6rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m);
    padding: 1.1rem 1.3rem;
  }
  .lh-sub { font-size: 0.95rem; font-weight: 750; color: var(--ink-2); margin-bottom: 0.3rem; }
  .lh-grid ul { margin-bottom: 0.5rem; }
  .lh-std { color: var(--muted); font-size: 0.9rem; margin: 0; }
  .toc { margin: 0; padding-left: 1.3em; font-size: 0.93rem; }
  .toc li { display: flex; justify-content: space-between; gap: 0.8rem; margin: 0.15rem 0; }
  .toc li::marker { color: var(--muted); }
  .toc a { color: var(--ink); text-decoration: none; }
  .toc a:hover { text-decoration: underline; }
  .toc-kind { font-weight: 750; margin-right: 0.35rem; color: var(--ink-2); }
  .toc-kind::after { content: ':'; }
  .toc-p { color: var(--muted); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .pager {
    display: flex; justify-content: space-between; gap: 1rem;
    max-width: var(--wide); margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid var(--line);
    font-weight: 650;
  }
  @media (max-width: 760px) {
    .lh-grid { grid-template-columns: 1fr; }
    .pager { flex-direction: column; }
  }
</style>
