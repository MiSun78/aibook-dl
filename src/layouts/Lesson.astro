---
import Base from './Base.astro';
import { LESSONS } from '../data/lessons';

interface Props {
  n: number;
  goals: string[];
  minutes?: string;
}
const { n, goals, minutes } = Astro.props;
const lesson = LESSONS.find((l) => l.n === n)!;
const prev = LESSONS.find((l) => l.n === n - 1);
const next = LESSONS.find((l) => l.n === n + 1);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title={`${n}차시 ${lesson.title}`} current={lesson.slug}>
  <header class="lesson-head">
    <p class="lh-meta">{n}차시{minutes ? `, ${minutes}` : ''}</p>
    <h1>{lesson.title}</h1>
    <p class="lh-q">{lesson.question}</p>
    <div class="lh-grid">
      <div>
        <h2 class="lh-sub">이번 시간에 할 수 있게 되는 것</h2>
        <ul>{goals.map((g) => <li>{g}</li>)}</ul>
      </div>
      <div class="lh-std">
        <h2 class="lh-sub">성취기준</h2>
        <p>[{lesson.standard}]</p>
        <p class="lh-four">4차시 반은 <strong>{lesson.four}</strong>에 배웁니다. 접힌 활동은 건너뛰어도 됩니다.</p>
      </div>
    </div>
  </header>

  <article class="prose">
    <slot />
  </article>

  <nav class="pager" aria-label="차시 이동">
    {prev ? <a href={`${base}/lessons/${prev.slug}/`}>이전 차시: {prev.title}</a> : <span />}
    {next ? <a href={`${base}/lessons/${next.slug}/`}>다음 차시: {next.title}</a> : <span />}
  </nav>
</Base>

<style>
  .lesson-head { max-width: var(--wide); padding-bottom: 0.4rem; }
  .lh-meta { color: var(--muted); font-weight: 650; margin-bottom: 0.3rem; }
  .lh-q { font-size: 1.25rem; color: var(--ink-2); margin: 0.6rem 0 1.6rem; max-width: var(--measure); }
  .lh-grid {
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 1.5rem;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m);
    padding: 1.1rem 1.3rem;
  }
  .lh-sub { font-size: 0.95rem; font-weight: 750; color: var(--ink-2); margin-bottom: 0.3rem; }
  .lh-grid ul { margin: 0; }
  .lh-std p { margin: 0 0 0.4rem; }
  .lh-four { display: none; font-size: 0.92rem; color: var(--ink-2); }
  :global(html[data-track='4']) .lh-four { display: block; }
  .pager {
    display: flex; justify-content: space-between; gap: 1rem;
    max-width: var(--wide); margin-top: 4rem; padding-top: 1.2rem; border-top: 1px solid var(--line);
    font-weight: 650;
  }
  @media (max-width: 700px) {
    .lh-grid { grid-template-columns: 1fr; }
    .pager { flex-direction: column; }
  }
</style>
