---
import '../styles/global.css';
import { SITE } from '../config';
import { UNITS } from '../data/lessons';

interface Props {
  title?: string;
  current?: string; // 현재 차시 slug 또는 'home' | 'teacher'
}
const { title, current = '' } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content="고등학교 인공지능 기초 '인공 신경망과 딥러닝' 단원을 이론과 실습으로 함께 배우는 디지털 교과서" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orioncactus/pretendard@v1.3.9/dist/web/variable/pretendardvariable-dynamic-subset.min.css" />
  </head>
  <body>
    <a class="skip" href="#main">본문으로 건너뛰기</a>
    <div class="shell">
      <aside class="side" aria-label="차시 목록">
        <a class="brand" href={`${base}/`}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 32 32" width="28" height="28">
              <line x1="6" y1="9" x2="16" y2="16" stroke="#2563eb" stroke-width="2.4" />
              <line x1="6" y1="23" x2="16" y2="16" stroke="#e0464e" stroke-width="1.6" />
              <line x1="16" y1="16" x2="26" y2="16" stroke="#2563eb" stroke-width="3" />
              <circle cx="6" cy="9" r="3.4" fill="#172038" />
              <circle cx="6" cy="23" r="3.4" fill="#172038" />
              <circle cx="16" cy="16" r="4.2" fill="#f2a516" />
              <circle cx="26" cy="16" r="3.4" fill="#172038" />
            </svg>
          </span>
          <span>
            <span class="brand-name">{SITE.title}</span>
            <span class="brand-sub">인공 신경망과 딥러닝</span>
          </span>
        </a>

        <nav>
          <p class="nav-cap">Ⅱ-03 인공 신경망과 딥러닝</p>
          <ol class="lesson-nav">
            {UNITS.map((u) => (
              <li class:list={[{ current: current === String(u.n), pending: !u.ready }]}>
                <a href={`${base}/lessons/${u.n}/`} aria-current={current === String(u.n) ? 'page' : undefined}>
                  <span class="ln-no">{u.code}</span>
                  <span class="ln-text">
                    <span class="ln-title">{u.title}</span>
                    <span class="ln-pages">교과서 {u.pages}{!u.ready && ', 준비 중'}</span>
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </nav>

        <a class:list={['teacher-link', { current: current === 'teacher' }]} href={`${base}/teacher/`}>선생님용 운영 안내</a>
      </aside>

      <main id="main" class="main">
        <slot />
        <footer class="foot">
          <p>{SITE.subtitle}. 수업용 디지털 교과서 시제품입니다.</p>
        </footer>
      </main>
    </div>

  </body>
</html>

<style>
  .skip {
    position: absolute; left: -999px; top: 0;
    background: var(--ink); color: #fff; padding: 0.5rem 1rem; z-index: 10;
  }
  .skip:focus { left: 0.5rem; top: 0.5rem; }

  .shell {
    background: linear-gradient(to right, var(--surface) 17.5rem, transparent 17.5rem);
    display: grid;
    grid-template-columns: 17.5rem 1fr;
    min-height: 100vh;
  }
  .side {
    position: sticky; top: 0; align-self: start;
    height: 100vh; overflow-y: auto;
    padding: 1.4rem 1.2rem 2rem;
    border-right: 1px solid var(--line);
    background: var(--surface);
    display: flex; flex-direction: column; gap: 1.4rem;
  }
  .brand { display: flex; gap: 0.65rem; align-items: center; text-decoration: none; color: var(--ink); }
  .brand-name { display: block; font-weight: 800; font-size: 1.05rem; letter-spacing: -0.02em; line-height: 1.3; }
  .brand-sub { display: block; font-size: 0.82rem; color: var(--muted); line-height: 1.3; }

  .nav-cap { font-size: 0.82rem; font-weight: 650; color: var(--muted); margin: 0 0 0.4rem 0.5rem; }
  .lesson-nav { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 0.15rem; }
  .lesson-nav li { margin: 0; }
  .lesson-nav a {
    display: grid; grid-template-columns: 2.6rem 1fr; gap: 0.3rem;
    padding: 0.55rem 0.5rem; border-radius: var(--radius-s);
    text-decoration: none; color: var(--ink); line-height: 1.35;
  }
  .lesson-nav a:hover { background: var(--paper); }
  .lesson-nav li.current a { background: var(--ink); color: #fff; }
  .lesson-nav li.current .ln-pages { color: #c9d0de; }
  .ln-no { font-weight: 800; font-size: 0.92rem; font-variant-numeric: tabular-nums; padding-top: 0.05rem; }
  .ln-title { display: block; font-weight: 650; font-size: 0.95rem; }
  .ln-pages { display: block; font-size: 0.78rem; color: var(--muted); }
  .lesson-nav li.pending .ln-title { color: var(--muted); }
  .lesson-nav li.current.pending .ln-title { color: #fff; }

  .teacher-link { margin-top: auto; font-size: 0.9rem; color: var(--ink-2); }
  .teacher-link.current { font-weight: 700; }

  .main { padding: 2.6rem clamp(1.2rem, 4vw, 4rem) 3rem; min-width: 0; }
  .foot { margin-top: 5rem; padding-top: 1rem; border-top: 1px solid var(--line); color: var(--muted); font-size: 0.85rem; }

  @media (max-width: 900px) {
    .shell { grid-template-columns: 1fr; background: none; }
    .side { position: static; height: auto; border-right: 0; border-bottom: 1px solid var(--line); }
    .lesson-nav { flex-direction: row; overflow-x: auto; gap: 0.3rem; }
    .lesson-nav a { min-width: 10.5rem; }
    .teacher-link { margin-top: 0; }
  }
</style>
