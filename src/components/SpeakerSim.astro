---
// 인공지능 스피커 흉내: 음성 인식(브라우저) → 전처리 → 형태소 분석 → 문장 구조 → 의미 분석 → 응답
---
<div class="widget sp" data-speaker>
  <p class="widget-title">인공지능 스피커 흉내 내기</p>
  <p class="widget-help">스피커에게 말을 걸어 보세요. 🎤 버튼을 누르고 말하거나 글자로 적은 뒤 [보내기]를 누릅니다. 아래에 스피커가 문장을 처리하는 네 단계가 나타납니다. 날씨, 시간, 날짜, 노래, 알람, 인사를 알아듣도록 규칙을 만들어 둔 흉내 스피커입니다.</p>

  <form class="sp-input" data-form>
    <button type="button" class="ghost sp-mic" data-mic aria-label="말로 입력하기" hidden>🎤</button>
    <input type="text" data-text value="오늘 날씨는 어때?" aria-label="스피커에게 할 말" />
    <button type="submit" class="btn">보내기</button>
  </form>
  <p class="sp-status" data-status aria-live="polite"></p>

  <ol class="sp-steps" data-steps></ol>

  <div class="sp-answer" data-answer hidden>
    <span class="sp-bot" aria-hidden="true">
      <svg viewBox="0 0 40 48" width="34" height="40"><rect x="4" y="4" width="32" height="40" rx="14" fill="#172038"/><circle cx="20" cy="18" r="5" fill="#f2a516"/><path d="M11 32h18M13 37h14" stroke="#5b6478" stroke-width="2"/></svg>
    </span>
    <p data-reply></p>
    <button type="button" class="ghost" data-say>🔊 다시 듣기</button>
  </div>
</div>

<style>
  .sp-input { display: flex; gap: 0.5rem; }
  .sp-input input {
    flex: 1; min-width: 0; font: inherit; font-size: 1rem; padding: 0.5rem 0.75rem;
    border: 1.5px solid var(--line-strong); border-radius: var(--radius-s);
  }
  .sp-input input:focus { outline: none; border-color: var(--ink); box-shadow: 0 0 0 3px var(--fire-soft); }
  .sp-mic { font-size: 1.1rem; padding-inline: 0.8rem; }
  .sp-mic.rec { background: var(--neg); border-color: var(--neg); color: #fff; }
  .sp-status { font-size: 0.85rem; color: var(--muted); min-height: 1.3em; margin: 0.35rem 0 0.6rem; }
  .sp-steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0.6rem; }
  .sp-steps :global(li) { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-s); padding: 0.7rem 0.75rem; }
  .sp-steps :global(.sp-h) { font-weight: 750; font-size: 0.9rem; margin: 0 0 0.15rem; }
  .sp-steps :global(.sp-d) { font-size: 0.78rem; color: var(--muted); margin: 0 0 0.5rem; }
  .sp-steps :global(.chips) { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  .sp-steps :global(.chip) { display: inline-flex; flex-direction: column; align-items: center; background: #fff; border: 1.5px solid var(--line-strong); border-radius: 6px; padding: 0.2rem 0.45rem; font-size: 0.9rem; font-weight: 650; }
  .sp-steps :global(.chip small) { font-size: 0.7rem; font-weight: 700; color: var(--pos); }
  .sp-steps :global(.chip .josa) { color: var(--neg); }
  .sp-steps :global(.res) { font-size: 0.92rem; font-weight: 650; }
  .sp-answer { display: flex; gap: 0.8rem; align-items: center; margin-top: 0.9rem; background: var(--fire-soft); border-radius: var(--radius-s); padding: 0.7rem 0.9rem; }
  .sp-answer p { flex: 1; margin: 0; font-weight: 650; }
  @media (max-width: 900px) { .sp-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) { .sp-steps { grid-template-columns: 1fr; } .sp-answer { flex-wrap: wrap; } .sp-answer p { flex-basis: calc(100% - 3.5rem); } }
</style>

<script>
  const JOSA = ['에서', '으로', '에게', '한테', '부터', '까지', '은', '는', '이', '가', '을', '를', '에', '도', '의', '로', '와', '과'];
  const TIME = ['오늘', '내일', '어제', '지금', '모레', '아침', '저녁', '밤', '이번', '주말'];
  const ROLE: Record<string, string> = { 은: '주어', 는: '주어', 이: '주어', 가: '주어', 을: '목적어', 를: '목적어' };

  type Tok = { word: string; stem: string; josa: string; role: string };

  function clean(s: string) { return s.replace(/[?!.,~…"'·]/g, ' ').replace(/\s+/g, ' ').trim(); }

  function analyze(sentence: string): Tok[] {
    const words = sentence ? sentence.split(' ') : [];
    return words.map((w, i) => {
      let stem = w, josa = '';
      const last = i === words.length - 1;
      if (!last && w.length > 1 && !TIME.includes(w)) {
        for (const j of JOSA) if (w.endsWith(j) && w.length > j.length) { stem = w.slice(0, -j.length); josa = j; break; }
      }
      const aux = i === words.length - 2 && /^(줘|줄래|주세요|줘요|봐|봐요|있어|있니|없어)$/.test(words[words.length - 1]);
      let role = '꾸미는 말';
      if (last || aux) role = '서술어';
      else if (TIME.includes(stem) || /^\d+(시|분)$/.test(stem)) role = '때(언제)';
      else if (ROLE[josa]) role = ROLE[josa];
      else if (['에', '에서', '으로', '로'].includes(josa)) role = '곳/방향';
      return { word: w, stem, josa, role };
    });
  }

  function intent(s: string): { name: string; reply: string } {
    const now = new Date();
    if (/날씨|비가|비 와|눈이|덥|춥|기온|우산/.test(s)) return { name: '날씨 묻기', reply: '날씨 정보를 찾아볼게요. (흉내 스피커라 실제 날씨는 몰라요. 진짜 스피커는 여기서 날씨 서비스에 물어봅니다.)' };
    if (/몇 ?시|시간/.test(s)) return { name: '시간 묻기', reply: `지금은 ${now.getHours()}시 ${now.getMinutes()}분이에요.` };
    if (/며칠|날짜|무슨 요일|요일/.test(s)) return { name: '날짜 묻기', reply: `오늘은 ${now.getMonth() + 1}월 ${now.getDate()}일 ${'일월화수목금토'[now.getDay()]}요일이에요.` };
    if (/알람|깨워/.test(s)) {
      const m = s.match(/(\d+|한|두|세|네|다섯|여섯|일곱|여덟|아홉|열|열한|열두)\s*시/);
      return { name: '알람 맞추기', reply: m ? `${m[0]}에 알람을 맞췄어요. (흉내)` : '몇 시에 알람을 맞출까요?' };
    }
    if (/노래|음악|틀어/.test(s)) return { name: '음악 틀기', reply: '신나는 노래를 틀어 드릴게요. ♪ (흉내)' };
    if (/안녕|반가|하이/.test(s)) return { name: '인사', reply: '안녕하세요! 무엇을 도와드릴까요?' };
    if (/고마|감사/.test(s)) return { name: '감사 표현', reply: '천만에요. 또 불러 주세요.' };
    return { name: '알 수 없음', reply: '잘 모르겠어요. 날씨, 시간, 날짜, 노래, 알람에 대해 물어봐 주세요.' };
  }

  document.querySelectorAll<HTMLElement>('[data-speaker]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-form]')!;
    const text = root.querySelector<HTMLInputElement>('[data-text]')!;
    const steps = root.querySelector<HTMLElement>('[data-steps]')!;
    const status = root.querySelector<HTMLElement>('[data-status]')!;
    const ans = root.querySelector<HTMLElement>('[data-answer]')!;
    const reply = root.querySelector<HTMLElement>('[data-reply]')!;
    const mic = root.querySelector<HTMLButtonElement>('[data-mic]')!;
    const esc = (s: string) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));

    function speak(s: string) {
      try {
        if (!('speechSynthesis' in window)) return;
        speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(s.replace(/\(.*?\)/g, ''));
        u.lang = 'ko-KR';
        speechSynthesis.speak(u);
      } catch {}
    }

    function run(raw: string, viaVoice = false, say = true) {
      const c = clean(raw);
      const toks = analyze(c);
      const it = intent(c);
      steps.innerHTML = `
        <li><p class="sp-h">① 데이터 전처리</p><p class="sp-d">문장 부호와 불필요한 공백을 지운다</p><p class="res">‘${esc(c) || '(빈 문장)'}’</p></li>
        <li><p class="sp-h">② 형태소 분석</p><p class="sp-d">의미 있는 작은 단위로 나눈다 (빨강: 조사)</p><div class="chips">${toks.map((t) => `<span class="chip">${esc(t.stem)}${t.josa ? `<span class="josa">+${esc(t.josa)}</span>` : ''}</span>`).join('')}</div></li>
        <li><p class="sp-h">③ 문장 구조 파악</p><p class="sp-d">단어가 문장에서 하는 역할을 찾는다</p><div class="chips">${toks.map((t) => `<span class="chip">${esc(t.word)}<small>${t.role}</small></span>`).join('')}</div></li>
        <li><p class="sp-h">④ 의미 분석</p><p class="sp-d">무엇을 원하는지(의도) 알아낸다</p><p class="res">의도: ${it.name}</p></li>`;
      reply.textContent = it.reply;
      ans.hidden = false;
      status.textContent = viaVoice ? `음성 인식 결과: “${raw}”` : '';
      if (say) speak(it.reply);
    }

    form.addEventListener('submit', (e) => { e.preventDefault(); run(text.value); });
    root.querySelector('[data-say]')!.addEventListener('click', () => speak(reply.textContent || ''));

    const SR = (window as any).SpeechRecognition || (window as any).webkitSpeechRecognition;
    if (SR) {
      mic.hidden = false;
      let rec: any = null;
      mic.addEventListener('click', () => {
        if (rec) { rec.stop(); return; }
        rec = new SR();
        rec.lang = 'ko-KR';
        rec.interimResults = true;
        mic.classList.add('rec');
        status.textContent = '듣고 있어요… 말을 마치면 잠시 기다리세요.';
        rec.onresult = (ev: any) => {
          const r = ev.results[ev.results.length - 1];
          text.value = r[0].transcript;
          if (r.isFinal) run(r[0].transcript, true);
        };
        rec.onerror = (ev: any) => {
          status.textContent = ev.error === 'not-allowed' ? '마이크 사용을 허용해야 말로 입력할 수 있어요. 글자로 적어도 됩니다.' : '음성을 알아듣지 못했어요. 다시 해 보거나 글자로 적어 주세요.';
        };
        rec.onend = () => { mic.classList.remove('rec'); rec = null; };
        rec.start();
      });
    } else {
      status.textContent = '이 브라우저는 음성 입력을 지원하지 않아요. 크롬이나 엣지에서는 🎤 버튼이 나타납니다.';
    }
    run(text.value, false, false);
  });
</script>
