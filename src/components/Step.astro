---
// 차시 흐름의 한 단계 (순서가 있으므로 번호를 쓴다)
interface Props {
  no: number;
  kind: '생각 열기' | '개념' | '해 보기' | '코랩 실습' | '기록과 성찰';
  title: string;
  id?: string;
}
const { no, kind, title, id } = Astro.props;
---
<section class="step-block" id={id}>
  <div class="step-head">
    <span class="step-no" aria-hidden="true">{no}</span>
    <span class="step-kind">{kind}</span>
    <h2 class="step-title">{title}</h2>
  </div>
  <div class="step-body">
    <slot />
  </div>
</section>
