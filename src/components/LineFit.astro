---
// 선형 회귀: 직접 기울기와 절편을 움직여 오차 함수와 결정계수를 줄여 보기
---
<div class="widget lf" data-linefit>
  <p class="widget-title">나의 선으로 최적의 선형 회귀 식 찾기</p>
  <p class="widget-help">목둘레(독립 변수)로 허리둘레(종속 변수)를 예측하는 선을 직접 그려 봅니다. 기울기(회귀계수 a)와 절편(b)을 움직여 오차 제곱의 합이 가장 작아지게 해 보세요. 데이터는 교과서 그림과 비슷하게 만든 연습용 40명입니다.</p>
  <div class="lf-ctl">
    <label>기울기 a <input type="range" min="0" max="5" step="0.01" value="0.5" data-a /> <b data-av></b></label>
    <label>절편 b <input type="range" min="-120" max="60" step="0.5" value="60" data-b /> <b data-bv></b></label>
  </div>
  <div class="lf-ctl">
    <label><input type="checkbox" checked data-res /> 오차(나머지) 보기</label>
    <label><input type="checkbox" data-sq /> 오차 제곱 보기</label>
    <button type="button" class="ghost" data-best aria-pressed="false">최적의 선 보기</button>
  </div>
  <div class="lf-grid">
    <svg data-svg viewBox="0 0 440 330" role="img" aria-label="목둘레와 허리둘레 산점도와 회귀선"></svg>
    <div>
      <p class="lf-eq" data-eq></p>
      <table class="lf-tab" data-tab></table>
      <p class="lf-msg" data-msg aria-live="polite"></p>
    </div>
  </div>
</div>

<style>
  .lf-ctl { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; align-items: center; margin-bottom: 0.5rem; font-size: 0.92rem; }
  .lf-ctl label { display: inline-flex; gap: 0.4rem; align-items: center; }
  .lf-ctl input[type='range'] { width: 9rem; }
  .lf-ctl button { padding: 0.3em 0.8em; font-size: 0.9rem; }
  .lf-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 1rem; align-items: start; }
  .lf-grid svg { width: 100%; height: auto; display: block; background: #fff; border: 1px solid var(--line); border-radius: var(--radius-s); }
  .lf-eq { font-weight: 700; margin: 0 0 0.5rem; }
  .lf-tab { width: 100%; font-size: 0.9rem; border-collapse: collapse; }
  .lf-tab :global(td), .lf-tab :global(th) { padding: 0.3em 0.4em; border-bottom: 1px solid var(--line); text-align: right; }
  .lf-tab :global(th:first-child), .lf-tab :global(td:first-child) { text-align: left; }
  .lf-msg { font-size: 0.9rem; margin: 0.6rem 0 0; color: var(--ink-2); }
  @media (max-width: 760px) { .lf-grid { grid-template-columns: 1fr; } }
</style>

<script>
  import { rng, gauss } from '../scripts/ml';
  document.querySelectorAll<HTMLElement>('[data-linefit]').forEach((root) => {
    const r = rng(7);
    const X = Array.from({ length: 40 }, () => +(34 + r() * 12).toFixed(1));
    const Y = X.map((x) => +(2.83 * x - 24.7 + gauss(r) * 3.6).toFixed(1));
    const n = X.length, mx = X.reduce((a, b) => a + b) / n, my = Y.reduce((a, b) => a + b) / n;
    const bestA = X.reduce((s, x, i) => s + (x - mx) * (Y[i] - my), 0) / X.reduce((s, x) => s + (x - mx) ** 2, 0);
    const bestB = my - bestA * mx;
    const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
    const ia = $<HTMLInputElement>('[data-a]'), ib = $<HTMLInputElement>('[data-b]');
    const res = $<HTMLInputElement>('[data-res]'), sq = $<HTMLInputElement>('[data-sq]'), best = $<HTMLButtonElement>('[data-best]');
    const svg = $<SVGSVGElement>('[data-svg]');
    const W = 440, H = 330, L = 46, R = 10, T = 10, B = 40;
    const x0 = 32, x1 = 48, y0 = 60, y1 = 120;
    const px = (v: number) => L + ((v - x0) / (x1 - x0)) * (W - L - R), py = (v: number) => H - B - ((v - y0) / (y1 - y0)) * (H - T - B);
    const metrics = (a: number, b: number) => {
      const e = X.map((x, i) => Y[i] - (a * x + b));
      const sse = e.reduce((s, v) => s + v * v, 0), tss = Y.reduce((s, v) => s + (v - my) ** 2, 0);
      return { mae: e.reduce((s, v) => s + Math.abs(v), 0) / n, mse: sse / n, rmse: Math.sqrt(sse / n), r2: 1 - sse / tss, sse };
    };
    const line = (a: number, b: number, c: string, w: number, d = '') =>
      `<line x1="${px(x0)}" y1="${py(a * x0 + b)}" x2="${px(x1)}" y2="${py(a * x1 + b)}" stroke="${c}" stroke-width="${w}" ${d}/>`;
    function draw() {
      const a = +ia.value, b = +ib.value;
      $('[data-av]').textContent = a.toFixed(2); $('[data-bv]').textContent = b.toFixed(1);
      let s = `<defs><clipPath id="lfc"><rect x="${L}" y="${T}" width="${W - L - R}" height="${H - T - B}"/></clipPath></defs>`;
      for (let v = 34; v <= 46; v += 2) s += `<line x1="${px(v)}" y1="${T}" x2="${px(v)}" y2="${H - B}" stroke="#eef0f4"/><text x="${px(v)}" y="${H - B + 15}" font-size="11" text-anchor="middle" fill="#5b6478">${v}</text>`;
      for (let v = 60; v <= 120; v += 10) s += `<line x1="${L}" y1="${py(v)}" x2="${W - R}" y2="${py(v)}" stroke="#eef0f4"/><text x="${L - 5}" y="${py(v) + 4}" font-size="11" text-anchor="end" fill="#5b6478">${v}</text>`;
      s += '<g clip-path="url(#lfc)">';
      X.forEach((x, i) => {
        const yh = a * x + b, e = Y[i] - yh;
        if (sq.checked) { const side = Math.abs(py(Y[i]) - py(yh)); s += `<rect x="${px(x)}" y="${Math.min(py(Y[i]), py(yh))}" width="${side}" height="${side}" fill="#e0464e" fill-opacity=".09" stroke="#e0464e" stroke-opacity=".35"/>`; }
        if (res.checked) s += `<line x1="${px(x)}" y1="${py(Y[i])}" x2="${px(x)}" y2="${py(yh)}" stroke="${e >= 0 ? '#e0464e' : '#e0464e'}" stroke-width="1.4"/>`;
      });
      if (best.getAttribute('aria-pressed') === 'true') s += line(bestA, bestB, '#138a52', 2.5, 'stroke-dasharray="7 4"');
      s += line(a, b, '#2563eb', 3);
      X.forEach((x, i) => { s += `<circle cx="${px(x)}" cy="${py(Y[i])}" r="4" fill="#172038" fill-opacity=".8"/>`; });
      s += '</g>';
      s += `<text x="${(L + W - R) / 2}" y="${H - 6}" font-size="12" font-weight="700" text-anchor="middle" fill="#172038">목둘레 (cm) · 독립 변수</text>`;
      s += `<text x="13" y="${(T + H - B) / 2}" font-size="12" font-weight="700" text-anchor="middle" fill="#172038" transform="rotate(-90 13 ${(T + H - B) / 2})">허리둘레 (cm) · 종속 변수</text>`;
      svg.innerHTML = s;
      const m = metrics(a, b), o = metrics(bestA, bestB);
      const showBest = best.getAttribute('aria-pressed') === 'true';
      $('[data-eq]').innerHTML = `<span style="color:#2563eb">나의 선</span>: 허리둘레 = ${a.toFixed(2)} × 목둘레 ${b < 0 ? '−' : '+'} ${Math.abs(b).toFixed(1)}` +
        (showBest ? `<br><span style="color:#138a52">최적의 선</span>: 허리둘레 = ${bestA.toFixed(2)} × 목둘레 ${bestB < 0 ? '−' : '+'} ${Math.abs(bestB).toFixed(1)}` : '');
      const row = (k: string, f: (q: typeof m) => string) => `<tr><td>${k}</td><td>${f(m)}</td>${showBest ? `<td>${f(o)}</td>` : ''}</tr>`;
      $('[data-tab]').innerHTML = `<tr><th></th><th>나의 선</th>${showBest ? '<th>최적의 선</th>' : ''}</tr>` +
        row('오차 제곱의 합', (q) => q.sse.toFixed(0)) + row('MAE', (q) => q.mae.toFixed(2)) + row('MSE', (q) => q.mse.toFixed(2)) +
        row('RMSE', (q) => q.rmse.toFixed(2)) + row('결정계수 R²', (q) => q.r2.toFixed(3));
      const gap = m.sse / o.sse;
      $('[data-msg]').textContent = m.r2 < 0 ? '결정계수가 0보다 작아요. 평균값 하나로 예측하는 것보다도 못한 선이에요.' :
        gap < 1.02 ? '아주 잘했어요! 최적의 선과 거의 같습니다.' : gap < 1.3 ? '거의 다 왔어요. 조금만 더 조절해 보세요.' : '점들 사이를 지나도록 기울기와 절편을 바꿔 보세요.';
    }
    [ia, ib].forEach((el) => el.addEventListener('input', draw));
    [res, sq].forEach((el) => el.addEventListener('change', draw));
    best.addEventListener('click', () => { best.setAttribute('aria-pressed', String(best.getAttribute('aria-pressed') !== 'true')); draw(); });
    draw();
  });
</script>
