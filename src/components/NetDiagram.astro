---
// 신경망 구조도. 층마다 이름, 노드 수, 활성화 함수를 적는다.
// 노드 수가 많은 층은 일부만 그리고 ⋮로 줄인다.
interface Layer { label: string; size: number; note?: string; inputs?: string[] }
interface Props {
  layers: Layer[];
  outputs?: string[];    // 출력 노드 이름
  hot?: number;          // 강조할 출력 노드 번호
  caption: string;
}
const { layers, outputs = [], hot, caption } = Astro.props;
const W = 660, H = 360, top = 44, bottom = 300;
const MAX = 6;
const cols = layers.map((l, ci) => {
  const x = 70 + (ci * (W - 170)) / (layers.length - 1);
  const shown = Math.min(l.size, ci === layers.length - 1 && l.size <= 10 ? 10 : MAX);
  const gap = l.size > shown ? Math.floor(shown / 2) : -1; // ⋮ 위치
  const slots = l.size > shown ? shown + 1 : shown;
  const ys = Array.from({ length: slots }, (_, i) => top + ((i + 0.5) * (bottom - top)) / slots);
  return { ...l, x, ys, gap };
});
const sign = (a: number, b: number) => ((a * 7 + b * 3) % 5 < 3 ? 'p' : 'n');
---
<figure class="nd">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={caption}>
    {cols.slice(0, -1).map((c, ci) => {
      const d = cols[ci + 1];
      return c.ys.flatMap((y1, i) => i === c.gap ? [] : d.ys.flatMap((y2, j) => j === d.gap ? [] : [
        <line x1={c.x} y1={y1} x2={d.x} y2={y2} class={`e ${sign(i + ci, j)}`} />
      ]));
    })}
    {cols.map((c, ci) => (
      <g>
        {c.ys.map((y, i) => i === c.gap
          ? <text x={c.x} y={y + 6} class="dots">⋮</text>
          : <circle cx={c.x} cy={y} r="9" class={ci === cols.length - 1 && i === hot ? 'node hot' : 'node'} />)}
        {c.inputs && c.ys.map((y, i) => i !== c.gap && c.inputs![i] ? <text x={c.x - 16} y={y + 4} class="tag end">{c.inputs![i]}</text> : null)}
        <text x={c.x} y="24" class="lbl">{c.label}</text>
        <text x={c.x} y="322" class="size">{c.size}개</text>
        {c.note && <text x={c.x} y="342" class="note">{c.note}</text>}
      </g>
    ))}
    {outputs.map((o, i) => <text x={cols[cols.length - 1].x + 16} y={cols[cols.length - 1].ys[i] + 4} class="tag">{o}</text>)}
  </svg>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .nd { margin: 1.4rem 0; }
  svg { width: 100%; height: auto; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-m); }
  .e { stroke-width: 0.8; opacity: 0.45; }
  .e.p { stroke: var(--pos); }
  .e.n { stroke: var(--neg); }
  .node { fill: #fff; stroke: var(--ink); stroke-width: 2; }
  .node.hot { fill: var(--fire); }
  .dots { font-size: 20px; text-anchor: middle; fill: var(--muted); }
  .lbl { font-size: 14px; font-weight: 700; text-anchor: middle; fill: var(--ink); font-family: var(--font); }
  .size { font-size: 14px; font-weight: 800; text-anchor: middle; fill: var(--ink); font-family: var(--font); }
  .note { font-size: 12px; text-anchor: middle; fill: var(--muted); font-family: var(--font); }
  .tag { font-size: 12px; fill: var(--ink-2); font-family: var(--font); }
  .tag.end { text-anchor: end; }
  figcaption { font-size: 0.9rem; color: var(--muted); margin-top: 0.5rem; max-width: var(--measure); }
</style>
