---
import './fig.css';
// 왼쪽: AND (직선 하나로 나뉨), 오른쪽: XOR (직선 하나로 안 나뉨, 은닉층의 두 선으로 나뉨)
const S = 150;
const px = (ox: number, v: number) => ox + 25 + v * 100;
const py = (v: number) => 60 + 100 - v * 100;
const pts = [[0, 0], [0, 1], [1, 0], [1, 1]];
const AND = [0, 0, 0, 1], XOR = [0, 1, 1, 0];
---
<figure class="fg">
  <svg viewBox="0 0 460 250" role="img" aria-label="AND 문제는 직선 하나로 1과 0을 나눌 수 있지만, XOR 문제는 직선 하나로 나눌 수 없고 은닉층이 그은 두 직선으로 나눌 수 있다">
    <text x="90" y="24" class="tb c">AND: 선형 문제</text>
    <text x="345" y="24" class="tb c">XOR: 비선형 문제</text>

    <!-- AND -->
    <rect x="15" y="40" width={S} height={S} rx="6" fill="#f6f7f9" />
    <polygon points={`${px(15, 0.55)},${py(1.2)} ${px(15, 1.2)},${py(1.2)} ${px(15, 1.2)},${py(0.55)}`} fill="#fdf3dc" />
    <line x1={px(15, 0.35)} y1={py(1.25)} x2={px(15, 1.25)} y2={py(0.35)} stroke="#172038" stroke-width="2.5" />
    {pts.map(([a, b], i) => <circle cx={px(15, a)} cy={py(b)} r="9" fill={AND[i] ? '#172038' : '#fff'} stroke="#172038" stroke-width="2.5" />)}
    <text x="90" y="214" class="t c">직선 하나로 나뉜다</text>
    <text x="90" y="232" class="ts c">퍼셉트론 하나로 해결</text>

    <!-- XOR -->
    <rect x="270" y="40" width={S} height={S} rx="6" fill="#f6f7f9" />
    <polygon points={`${px(270, -0.2)},${py(0.45)} ${px(270, 0.45)},${py(-0.2)} ${px(270, 1.2)},${py(-0.2)} ${px(270, 1.2)},${py(0.55)} ${px(270, 0.55)},${py(1.2)} ${px(270, -0.2)},${py(1.2)}`} fill="#fdf3dc" />
    <line x1={px(270, -0.2)} y1={py(0.45)} x2={px(270, 0.45)} y2={py(-0.2)} stroke="#2563eb" stroke-width="2.5" />
    <line x1={px(270, 0.55)} y1={py(1.2)} x2={px(270, 1.2)} y2={py(0.55)} stroke="#2563eb" stroke-width="2.5" />
    {pts.map(([a, b], i) => <circle cx={px(270, a)} cy={py(b)} r="9" fill={XOR[i] ? '#172038' : '#fff'} stroke="#172038" stroke-width="2.5" />)}
    <text x="345" y="214" class="t c">직선 하나로는 안 된다</text>
    <text x="345" y="232" class="ts c">은닉층이 그은 두 선(파랑)으로 해결</text>

    <circle cx="200" cy="90" r="6" fill="#172038" /><text x="210" y="94" class="ts">출력 1</text>
    <circle cx="200" cy="112" r="6" fill="#fff" stroke="#172038" stroke-width="2" /><text x="210" y="116" class="ts">출력 0</text>
    <rect x="194" y="128" width="12" height="12" fill="#fdf3dc" /><text x="210" y="138" class="ts">1로 판단</text>
  </svg>
  <figcaption>가로축은 x₁, 세로축은 x₂, 네 점은 (0,0), (0,1), (1,0), (1,1)이다.</figcaption>
</figure>
