---
import './fig.css';
const S = [
  { t: '데이터 살펴보기', d: ['형태·규모·유형 확인', '통계 요약', '시각화'], c: 'boxb' },
  { t: '데이터 전처리', d: ['결측치 처리', '이상치 처리', '정규화'], c: 'boxh' },
  { t: '핵심 속성 추출', d: ['상관관계 분석', '불필요한 속성 제거', '공정성 검토'], c: 'boxb' },
];
---
<figure class="fg">
  <svg viewBox="0 0 460 170" role="img" aria-label="수집한 데이터는 데이터 살펴보기, 데이터 전처리, 핵심 속성 추출을 거쳐 기계학습에 쓸 준비를 마친다">
    <defs>
      <marker id="fed-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#3a4560" /></marker>
    </defs>
    {S.map((s, i) => (
      <g>
        <rect x={10 + i * 152} y="20" width="136" height="118" rx="10" class={s.c} />
        <circle cx={30 + i * 152} cy="42" r="12" fill="#172038" />
        <text x={30 + i * 152} y="47" class="t c" style="fill:#fff;font-weight:800">{i + 1}</text>
        <text x={48 + i * 152} y="47" class="tb">{s.t}</text>
        {s.d.map((d, j) => <text x={24 + i * 152} y={78 + j * 20} class="t">· {d}</text>)}
        {i < 2 && <line x1={148 + i * 152} y1="80" x2={160 + i * 152} y2="80" class="arw" marker-end="url(#fed-a)" />}
      </g>
    ))}
    <text x="230" y="160" class="ts c">탐색적 데이터 분석(EDA): 통계와 그래프로 데이터를 충분히 이해하기</text>
  </svg>
  <figcaption>기계학습을 위한 데이터 탐색과 전처리 과정</figcaption>
</figure>
