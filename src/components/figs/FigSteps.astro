---
import './fig.css';
const steps = [
  { t: '문제 정의하기', d: '목표, 쓸 데이터, 기대 결과', h: 46 },
  { t: '데이터 수집 및 전처리하기', d: '수집 → 결측치·이상치 처리 → 정규화', h: 46 },
  { t: '모델 생성하기', d: '', h: 118 },
  { t: '모델 평가 및 예측하기', d: '테스트 데이터로 성능 측정', h: 46 },
];
let y = 14;
const boxes = steps.map((s) => { const b = { ...s, y }; y += s.h + 22; return b; });
---
<figure class="fg">
  <svg viewBox="0 0 360 340" role="img" aria-label="신경망 모델 구현 4단계: 문제 정의, 데이터 수집 및 전처리, 모델 생성(설계, 환경 설정, 학습), 모델 평가 및 예측">
    <defs>
      <marker id="fs-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#3a4560" /></marker>
    </defs>
    {boxes.map((b, i) => (
      <g>
        <rect x="14" y={b.y} width="332" height={b.h} rx="8" class={i === 2 ? 'boxb' : 'box'} />
        <circle cx="38" cy={b.y + 23} r="13" fill="#172038" />
        <text x="38" y={b.y + 28} class="tb c" style="fill:#fff">{i + 1}</text>
        <text x="62" y={b.y + 21} class="tb">{b.t}</text>
        {b.d && <text x="62" y={b.y + 38} class="ts">{b.d}</text>}
        {i < 3 && <line x1="180" y1={b.y + b.h + 2} x2="180" y2={b.y + b.h + 19} class="arw" marker-end="url(#fs-a)" />}
      </g>
    ))}
    {['설계: 층, 노드 수, 활성화 함수', '환경 설정: 손실 함수, 최적화 함수', '학습: 훈련 데이터로 반복 학습'].map((t, j) => (
      <g>
        <rect x="62" y={boxes[2].y + 34 + j * 26} width="270" height="21" rx="5" fill="#fff" stroke="#2563eb" stroke-width="1.2" />
        <text x="72" y={boxes[2].y + 49 + j * 26} class="t">{t}</text>
      </g>
    ))}
  </svg>
  <figcaption>신경망을 직접 설계하는 3단계가 이전 기계학습 모델과 다른 점이다.</figcaption>
</figure>
