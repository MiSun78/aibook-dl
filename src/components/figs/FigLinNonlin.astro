---
import './fig.css';
const F = [[40, 50], [60, 40], [52, 72], [80, 60], [70, 90]], V = [[130, 140], [150, 120], [160, 160], [120, 160], [175, 140]];
const F2 = [[270, 40], [300, 34], [420, 50], [425, 160], [270, 160], [345, 166], [430, 105], [262, 100]], V2 = [[330, 80], [360, 90], [345, 120], [375, 70], [315, 110], [370, 130]];
---
<figure class="fg">
  <svg viewBox="0 0 460 210" role="img" aria-label="직선 하나로 클래스를 나눌 수 있으면 선형 분류, 곡선이나 여러 경계가 필요하면 비선형 분류이다">
    <rect x="20" y="20" width="190" height="160" rx="6" fill="#fff" stroke="#dde1e8" />
    <line x1="30" y1="170" x2="200" y2="30" stroke="#172038" stroke-width="2" stroke-dasharray="6 4" />
    {F.map(([x, y]) => <circle cx={x} cy={y} r="6" fill="#e0464e" />)}
    {V.map(([x, y]) => <rect x={x - 6} y={y - 6} width="12" height="12" fill="#138a52" />)}
    <text x="115" y="200" class="tb c">선형 분류</text>
    <rect x="250" y="20" width="190" height="160" rx="6" fill="#fff" stroke="#dde1e8" />
    <ellipse cx="345" cy="100" rx="62" ry="48" fill="none" stroke="#172038" stroke-width="2" stroke-dasharray="6 4" />
    {F2.map(([x, y]) => <circle cx={x} cy={y} r="6" fill="#e0464e" />)}
    {V2.map(([x, y]) => <rect x={x - 6} y={y - 6} width="12" height="12" fill="#138a52" />)}
    <text x="345" y="200" class="tb c">비선형 분류</text>
    <text x="30" y="16" class="ts">● 과일  ■ 채소   (가로: 아삭함, 세로: 당도)</text>
  </svg>
  <figcaption>분류 모델의 핵심은 클래스 영역을 나누는 경계를 찾는 것이다.</figcaption>
</figure>
