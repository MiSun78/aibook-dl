---
import './fig.css';
const G = [
  { x: 90, t: '지도학습', d: '정답(레이블)이 있는 데이터', kids: [{ t: '분류', a: ['결정트리', '로지스틱 회귀', 'kNN'] }, { t: '회귀', a: ['선형 회귀'] }], cls: 'boxb' },
  { x: 270, t: '비지도학습', d: '정답이 없는 데이터', kids: [{ t: '군집', a: ['k-평균', '군집화'] }, { t: '연관 규칙', a: ['장바구니', '분석'] }], cls: 'boxh' },
  { x: 430, t: '강화 학습', d: '시행착오와 보상', kids: [{ t: '보상 최대화', a: ['게임,', '로봇 제어'] }], cls: 'box' },
];
---
<figure class="fg">
  <svg viewBox="0 0 520 250" role="img" aria-label="기계학습은 학습 방법에 따라 지도학습, 비지도학습, 강화 학습으로 나뉜다. 지도학습은 분류와 회귀, 비지도학습은 군집과 연관 규칙에 쓰인다">
    <rect x="200" y="10" width="120" height="34" rx="17" class="hot" />
    <text x="260" y="32" class="tb c">기계학습</text>
    {G.map((g) => (
      <g>
        <path d={`M260 44 L260 58 L${g.x} 58 L${g.x} 70`} class="arw" />
        <rect x={g.x - 78} y="70" width="156" height="50" rx="8" class={g.cls} />
        <text x={g.x} y="92" class="tb c">{g.t}</text>
        <text x={g.x} y="110" class="ts c">{g.d}</text>
        {g.kids.map((k, i) => {
          const kx = g.kids.length === 1 ? g.x : g.x - 40 + i * 80;
          return (
            <g>
              <line x1={g.x} y1="120" x2={kx} y2="146" class="arw" />
              <rect x={kx - 38} y="146" width="76" height="30" rx="6" fill="#fff" stroke="#b9c0cc" />
              <text x={kx} y="166" class="t c" style="font-weight:700">{k.t}</text>
              {k.a.map((a, j) => <text x={kx} y={194 + j * 15} class="ts c">{a}</text>)}
            </g>
          );
        })}
      </g>
    ))}
  </svg>
  <figcaption>해결할 문제와 데이터에 정답이 있는지에 따라 기계학습 유형과 알고리즘을 고른다.</figcaption>
</figure>
