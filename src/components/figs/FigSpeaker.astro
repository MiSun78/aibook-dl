---
import './fig.css';
const steps = ['데이터 전처리', '형태소 분석', '문장 구조 파악', '의미 분석'];
---
<figure class="fg">
  <svg viewBox="0 0 460 250" role="img" aria-label="인공지능 스피커의 동작: 마이크로 들어온 음성을 음성 인식으로 텍스트로 바꾸고, 자연어 처리의 네 단계를 거쳐 의도를 파악한 뒤 대답을 출력한다">
    <defs>
      <marker id="fsp-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#3a4560" /></marker>
    </defs>
    <!-- 사람 말풍선 -->
    <rect x="10" y="20" width="96" height="34" rx="17" fill="#fff" stroke="#172038" stroke-width="1.5" />
    <text x="58" y="42" class="t c">"내일 비 와?"</text>
    <!-- 스피커 -->
    <rect x="34" y="72" width="48" height="66" rx="20" fill="#172038" />
    <circle cx="58" cy="94" r="8" fill="#f2a516" />
    <path d="M44 116h28M46 124h24" stroke="#5b6478" stroke-width="2" />
    <text x="58" y="156" class="ts c">마이크로 입력</text>

    <line x1="90" y1="104" x2="122" y2="104" class="arw" marker-end="url(#fsp-a)" />
    <rect x="126" y="80" width="92" height="48" rx="8" class="boxb" />
    <text x="172" y="100" class="tb c">음성 인식</text>
    <text x="172" y="118" class="ts c">음성 → 텍스트</text>
    <line x1="222" y1="104" x2="246" y2="104" class="arw" marker-end="url(#fsp-a)" />

    <rect x="250" y="20" width="200" height="168" rx="10" class="boxh" />
    <text x="350" y="40" class="tb c">자연어 처리</text>
    {steps.map((s, i) => (
      <g>
        <rect x="264" y={52 + i * 32} width="172" height="26" rx="6" fill="#fff" stroke="#f2a516" />
        <circle cx="280" cy={65 + i * 32} r="9" fill="#172038" />
        <text x="280" y={69 + i * 32} class="ts c" style="fill:#fff;font-weight:700">{i + 1}</text>
        <text x="296" y={70 + i * 32} class="t">{s}</text>
      </g>
    ))}

    <path d="M350 192 L350 214 L120 214" class="arw" marker-end="url(#fsp-a)" />
    <rect x="10" y="196" width="106" height="38" rx="19" fill="#fde7ea" stroke="#e0464e" stroke-width="1.5" />
    <text x="63" y="219" class="t c">"우산 챙기세요"</text>
    <text x="236" y="232" class="ts c">약속된 동작 수행: 날씨 확인 → 음성으로 대답</text>
  </svg>
  <figcaption>인공지능 스피커는 음성 인식으로 말을 텍스트로 바꾸고, 자연어 처리로 그 뜻을 이해한 뒤 미리 약속된 동작을 한다.</figcaption>
</figure>
