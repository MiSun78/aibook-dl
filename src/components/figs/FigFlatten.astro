---
import './fig.css';
// 28×28 숫자 7 그림을 만들고, 한 줄(784개)로 펼쳐 입력층에 넣는 과정을 그린다.
const N = 28, cell = 5;
const img: number[][] = Array.from({ length: N }, () => Array(N).fill(0));
const ink = (r: number, c: number, v = 1) => { if (r >= 0 && r < N && c >= 0 && c < N) img[r][c] = Math.max(img[r][c], v); };
for (let c = 7; c <= 21; c++) { ink(6, c, 0.9); ink(7, c); ink(8, c, 0.6); }
for (let t = 0; t <= 1; t += 0.01) {
  const r = Math.round(8 + t * 14), c = Math.round(21 - t * 9);
  ink(r, c); ink(r, c - 1, 0.8); ink(r, c + 1, 0.4);
}
const flat = img.flat();
// 펼친 줄에서 보여 줄 칸: 앞 6칸, 가운데(숫자가 지나는) 6칸, 뒤 4칸
const show = [0, 1, 2, 3, 4, 5, -1, 202, 203, 204, 205, 206, 207, -1, 780, 781, 782, 783];
---
<figure class="fg">
  <svg viewBox="0 0 460 250" role="img" aria-label="28×28 픽셀 그림을 한 줄로 펼치면 784개의 수가 되고, 이것이 입력층의 784개 노드에 하나씩 들어간다">
    <defs>
      <marker id="fl-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#3a4560" /></marker>
    </defs>
    <text x="84" y="22" class="tb c">28 × 28 그림</text>
    <rect x="14" y="34" width={N * cell} height={N * cell} fill="#000" />
    {img.map((row, r) => row.map((v, c) => v > 0 && (
      <rect x={14 + c * cell} y={34 + r * cell} width={cell} height={cell} fill={`rgb(${Math.round(v * 255)},${Math.round(v * 255)},${Math.round(v * 255)})`} />
    )))}
    <text x="84" y="196" class="ts c">픽셀값 0(검정) ~ 255(흰색)</text>
    <text x="84" y="212" class="ts c">→ 255로 나눠 0~1로</text>

    <line x1="162" y1="104" x2="206" y2="104" class="arw" marker-end="url(#fl-a)" />
    <text x="184" y="94" class="ts c">Flatten</text>

    <text x="246" y="22" class="tb c">한 줄로 펼침</text>
    {show.map((k, i) => k < 0
      ? <text x="246" y={40 + i * 9 + 7} class="ts c">⋮</text>
      : <rect x="234" y={34 + i * 9} width="24" height="8" fill={`rgb(${Math.round(flat[k] * 255)},${Math.round(flat[k] * 255)},${Math.round(flat[k] * 255)})`} stroke="#5b6478" stroke-width="0.6" />)}
    <text x="246" y="212" class="ts c">수 784개</text>

    <line x1="268" y1="104" x2="306" y2="104" class="arw" marker-end="url(#fl-a)" />

    <text x="380" y="22" class="tb c">입력층 → … → 출력층</text>
    {[0, 1, 2, 3, 5, 6, 7].map((i) => <circle cx="326" cy={44 + i * 20} r="7" class="node" />)}
    <text x="326" y="128" class="ts c">⋮</text>
    {[0, 1, 2, 3, 4].map((i) => <line x1="333" y1={44 + i * 30} x2="372" y2="104" stroke="#b9c0cc" />)}
    <rect x="372" y="84" width="36" height="40" rx="6" fill="#e3ecfd" stroke="#2563eb" />
    <text x="390" y="108" class="ts c" style="fill:#2563eb;font-weight:700">은닉</text>
    <line x1="408" y1="104" x2="426" y2="104" class="arw" marker-end="url(#fl-a)" />
    <circle cx="440" cy="104" r="11" class="hot" />
    <text x="440" y="109" class="ts c" style="fill:#172038;font-weight:800">7</text>
    <text x="326" y="212" class="ts c">784개</text>
    <text x="452" y="212" class="ts e">10개 중 가장</text>
    <text x="452" y="226" class="ts e">큰 확률</text>
  </svg>
  <figcaption>그림 한 장은 784개의 수다. 픽셀 하나가 입력층의 노드 하나에 들어간다.</figcaption>
</figure>
