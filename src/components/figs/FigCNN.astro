---
import './fig.css';
// 합성곱 신경망 구조: 입력 → 합성곱 → 풀링 → 합성곱 → 풀링 → 평탄화 → 완전 연결 → 분류
const stack = (x: number, y: number, s: number, n: number, fill: string) =>
  Array.from({ length: n }).map((_, i) => ({ x: x + i * 5, y: y - i * 5, s, fill }));
const blocks = [
  ...stack(98, 72, 62, 4, '#e3ecfd'),
  ...stack(172, 82, 42, 4, '#fdf3dc'),
  ...stack(232, 84, 34, 6, '#e3ecfd'),
  ...stack(300, 90, 22, 6, '#fdf3dc'),
];
---
<figure class="fg">
  <svg viewBox="0 0 460 230" role="img" aria-label="합성곱 신경망: 입력 이미지가 합성곱 층과 풀링 층을 두 번 거치며 특징이 추출되고 크기가 줄어든 뒤, 평탄화되어 완전 연결 계층에서 고양이, 개, 사자 중 하나로 분류된다">
    <defs>
      <marker id="fc-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0 0 L10 5 L0 10z" fill="#3a4560" /></marker>
    </defs>
    <!-- 입력 이미지 -->
    <rect x="10" y="62" width="70" height="70" fill="#fff" stroke="#172038" stroke-width="2" />
    <path d="M24 120 L30 84 L42 96 L56 96 L68 84 L72 120z" fill="#f2a516" stroke="#172038" stroke-width="1.5" />
    <circle cx="40" cy="104" r="2.5" fill="#172038" /><circle cx="58" cy="104" r="2.5" fill="#172038" />
    <path d="M45 112 L49 115 L53 112" fill="none" stroke="#172038" stroke-width="1.3" />
    {blocks.map((b) => <rect x={b.x} y={b.y} width={b.s} height={b.s} fill={b.fill} stroke="#3a4560" stroke-width="1" />)}
    <!-- 평탄화 -->
    {Array.from({ length: 10 }).map((_, i) => <rect x="350" y={42 + i * 11} width="10" height="10" fill="#fff" stroke="#3a4560" />)}
    <!-- 완전 연결 -->
    {[0, 1, 2, 3, 4].map((i) => [0, 1, 2].map((j) => <line x1="364" y1={50 + i * 22} x2="400" y2={70 + j * 30} stroke="#b9c0cc" />))}
    {[0, 1, 2].map((j) => <circle cx="404" cy={70 + j * 30} r="8" class={j === 0 ? 'hot' : 'node'} />)}
    {['고양이', '개', '사자'].map((t, j) => <text x="418" y={74 + j * 30} class="t" style={j === 0 ? 'font-weight:700' : ''}>{t}</text>)}

    <text x="45" y="152" class="t c">입력</text>
    <text x="125" y="152" class="t c">합성곱 층</text>
    <text x="190" y="152" class="t c">풀링 층</text>
    <text x="258" y="152" class="t c">합성곱 층</text>
    <text x="320" y="152" class="t c">풀링 층</text>
    <text x="378" y="170" class="t c">완전 연결 계층</text>

    <path d="M98 172 L98 182 L340 182 L340 172" fill="none" stroke="#2563eb" stroke-width="2" />
    <text x="219" y="200" class="tb c" style="fill:#2563eb">특징 추출</text>
    <text x="219" y="216" class="ts c">특징맵이 많아지고 크기는 작아진다</text>
    <path d="M348 188 L348 196 L446 196 L446 188" fill="none" stroke="#e0464e" stroke-width="2" />
    <text x="397" y="214" class="tb c" style="fill:#e0464e">분류</text>
  </svg>
  <figcaption>합성곱 층은 특징을 뽑고, 풀링 층은 중요한 값만 남겨 크기를 줄인다. 이렇게 얻은 특징값이 완전 연결 계층의 입력이 된다.</figcaption>
</figure>
