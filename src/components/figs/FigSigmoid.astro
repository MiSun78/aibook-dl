---
import './fig.css';
const pts = Array.from({ length: 61 }, (_, i) => { const x = -6 + i * 0.2; return [40 + (x + 6) * 30, 160 - 130 / (1 + Math.exp(-x))]; });
---
<figure class="fg">
  <svg viewBox="0 0 440 200" role="img" aria-label="로지스틱 함수는 S자 곡선으로 값을 0에서 1 사이의 확률로 바꾼다. 확률이 0.5 이상이면 합격으로 분류한다">
    <line x1="40" y1="160" x2="410" y2="160" class="arw" /><line x1="40" y1="165" x2="40" y2="20" class="arw" />
    <line x1="40" y1="95" x2="410" y2="95" stroke="#b9c0cc" stroke-dasharray="4 4" />
    <rect x="220" y="20" width="190" height="140" fill="#e3ecfd" opacity=".6" />
    <path d={'M' + pts.map((p) => p.join(' ')).join(' L')} fill="none" stroke="#e0464e" stroke-width="3" />
    <text x="34" y="34" class="ts e">1</text><text x="34" y="99" class="ts e">0.5</text><text x="34" y="164" class="ts e">0</text>
    <text x="315" y="44" class="tb c" style="fill:#2563eb">합격으로 분류</text>
    <text x="130" y="140" class="tb c">불합격으로 분류</text>
    <text x="225" y="184" class="t c">점수 →</text>
    <text x="14" y="90" class="ts c" transform="rotate(-90 14 90)">합격 확률</text>
  </svg>
  <figcaption>로지스틱 회귀: 선형 회귀의 결과를 S자 모양의 로지스틱 함수로 0~1 사이 확률로 바꾸고, 기준(보통 0.5)으로 분류한다.</figcaption>
</figure>
