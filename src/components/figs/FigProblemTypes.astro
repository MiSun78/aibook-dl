---
import './fig.css';
const T = [
  { t: '분류', d: '정해진 그룹 중 하나로', e: '스팸 메일 / 정상 메일' },
  { t: '예측', d: '값을 추정', e: '내일 기온, 집값' },
  { t: '군집', d: '비슷한 것끼리 묶기', e: '비슷한 고객 묶기' },
  { t: '인식', d: '이미지·음성·글 이해', e: '얼굴로 감정 알기' },
  { t: '자연어 처리', d: '사람의 언어 다루기', e: '번역, 요약' },
  { t: '생성', d: '새 콘텐츠 만들기', e: '그림, 글, 음성 생성' },
];
const icon = (i: number) => [
  '<rect x="-14" y="-10" width="12" height="20" rx="2" fill="#2563eb"/><rect x="2" y="-10" width="12" height="20" rx="2" fill="#e0464e"/>',
  '<path d="M-16 10 L-6 2 L2 6 L14 -10" fill="none" stroke="#2563eb" stroke-width="3"/><circle cx="14" cy="-10" r="3.5" fill="#f2a516"/>',
  '<circle cx="-8" cy="-4" r="3" fill="#2563eb"/><circle cx="-12" cy="4" r="3" fill="#2563eb"/><circle cx="-4" cy="5" r="3" fill="#2563eb"/><circle cx="9" cy="-6" r="3" fill="#e0464e"/><circle cx="13" cy="3" r="3" fill="#e0464e"/>',
  '<circle cx="0" cy="0" r="12" fill="none" stroke="#172038" stroke-width="2.5"/><circle cx="-4" cy="-3" r="1.8" fill="#172038"/><circle cx="4" cy="-3" r="1.8" fill="#172038"/><path d="M-5 4 Q0 8 5 4" stroke="#172038" stroke-width="2" fill="none"/>',
  '<rect x="-15" y="-11" width="22" height="14" rx="4" fill="#2563eb"/><rect x="-6" y="-1" width="22" height="14" rx="4" fill="#f2a516"/>',
  '<path d="M0 -13 L3.5 -4 L13 -4 L5.5 2 L8.5 12 L0 6 L-8.5 12 L-5.5 2 L-13 -4 L-3.5 -4z" fill="#f2a516" stroke="#172038" stroke-width="1.5"/>',
][i];
---
<figure class="fg">
  <svg viewBox="0 0 460 250" role="img" aria-label="기계학습으로 해결할 수 있는 문제 유형 여섯 가지: 분류, 예측, 군집, 인식, 자연어 처리, 생성">
    {T.map((x, i) => {
      const cx = 10 + (i % 3) * 150, cy = 10 + Math.floor(i / 3) * 120;
      return (
        <g>
          <rect x={cx} y={cy} width="140" height="110" rx="10" fill="#fff" stroke="#dde1e8" />
          <g transform={`translate(${cx + 70},${cy + 30})`} set:html={icon(i)} />
          <text x={cx + 70} y={cy + 66} class="tb c">{x.t}</text>
          <text x={cx + 70} y={cy + 84} class="ts c">{x.d}</text>
          <text x={cx + 70} y={cy + 100} class="ts c" style="fill:#2563eb">예) {x.e}</text>
        </g>
      );
    })}
  </svg>
  <figcaption>기계학습이 모델을 만들어 해결하는 문제의 여섯 가지 유형</figcaption>
</figure>
